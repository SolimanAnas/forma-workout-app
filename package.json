{
  "name": "forma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sensor-powered fitness PWA — the phone becomes a real-time exercise sensor, rep counter, and coach.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tune": "tsx scripts/tune.ts",
    "images": "node scripts/optimize-exercise-images.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  }
}
